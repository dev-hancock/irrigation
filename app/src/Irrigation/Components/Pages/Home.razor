@page "/"
@rendermode InteractiveServer
@using Irrigation.Application.Common
@using Irrigation.Application.Valves
@using Irrigation.Application.Valves.Commands
@using Irrigation.Application.Valves.Requests
@using Irrigation.Application.Valves.Requests.Contracts
@using Irrigation.Components.Dashboard
@using Mediator
@implements IDisposable

@inject IMediator Mediator
@inject IEventBus Events

<PageTitle>Irrigation Dashboard</PageTitle>

<section class="dashboard-page" aria-labelledby="dashboard-heading">
    <header class="dashboard-page__header">
        <div>
            <h1 id="dashboard-heading">Dashboard</h1>
            <p>Overview of your irrigation system</p>
        </div>
        <div class="dashboard-page__actions">
            <button class="dashboard-button" type="button"><i class="ti ti-refresh" aria-hidden="true"></i>Refresh</button>
            <button class="dashboard-button dashboard-button--primary" type="button"><i class="ti ti-restore" aria-hidden="true"></i>Reset All Valves</button>
        </div>
    </header>

    <MetricList
        TotalValves="@TotalValves"
        OpenValves="@OpenValves"
        ActiveSchedules="@ActiveSchedules"
        NextSchedule="@NextSchedule">
    </MetricList>

    <ValveTable
        Valves="@Valves"
        OnOpen="@OpenValve"
        OnClose="@CloseValve"/>

    <div class="dashboard-page__lower-grid">
        <ActiveSchedules Schedules="Schedules"/>
        <RecentActivity Activities="Activities"/>
    </div>
</section>

@code {

    private string _error;

    private DashboardMetric TotalValves { get; } = new("Total Valves", "4", "Configured");
    private DashboardMetric OpenValves { get; } = new("Open Valves", "4", "25%");
    private DashboardMetric ActiveSchedules { get; } = new("Active Schedules", "2", "Running now");
    private DashboardMetric NextSchedule { get; } = new("Next Schedule", "18:30", "Garden Bed Watering");

    private readonly List<ValveSummary> _valves = [];

    public IReadOnlyList<ValveSummary> Valves => _valves.AsReadOnly();

    private static IReadOnlyList<ScheduleSummary> Schedules { get; } =
    [
        new("Morning Watering", "Daily · 06:00", true),
        new("Evening Garden", "Daily · 18:30", true)
    ];

    private static IReadOnlyList<ActivitySummary> Activities { get; } =
    [
        new("10:14:23", "Valve 1 opened", "Manual", true),
        new("09:45:10", "Valve 2 closed", "Manual", false),
        new("08:30:05", "Valve 3 closed", "Schedule", false),
        new("07:15:42", "Valve 4 closed", "Schedule", false)
    ];

    private IDisposable? _token;

    protected override async Task OnInitializedAsync()
    {
        _token = Events.Subscribe<ValveChanged>(async (x, t) =>
        {
            var result = await Mediator.Send(new GetValveRequest
            {
                Id = x.Id
            }, t);

            if (result.IsError)
            {
                return;
            }

            CreateOrUpdate(result.Value);

            await InvokeAsync(StateHasChanged);
        });

        var result = await Mediator.Send(new GetValvesRequest());


        if (result.IsError)
        {
            _error = result.FirstError.Description;
        }

        foreach (var valve in result.Value)
        {
            CreateOrUpdate(valve);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void CreateOrUpdate(ValveDto dto)
    {
        var existing = _valves.FirstOrDefault(x => x.Id == dto.Id);

        var updated = new ValveSummary(
            dto.Id,
            dto.Index,
            dto.Name,
            "Zone",
            dto.Status,
            dto.Updated);

        if (existing is null)
        {
            _valves.Add(updated);
        }
        else
        {
            var index = _valves.IndexOf(existing);

            _valves[index] = updated;
        }
    }

    private async Task OpenValve(Guid id)
    {
        var result = await Mediator.Send(
            new OpenValveCommand
            {
                Id = id
            });

        if (result.IsError)
        {
            _error = result.FirstError.Description;
        }
    }

    private async Task CloseValve(Guid id)
    {
        var result = await Mediator.Send(
            new CloseValveCommand
            {
                Id = id
            });

        if (result.IsError)
        {
            _error = result.FirstError.Description;
        }
    }

    public void Dispose()
    {
        _token?.Dispose();
        _token = null;
    }

}